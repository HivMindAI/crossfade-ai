# Server-only key issued for the Qloo Agentic Hackathon.
QLOO_API_KEY=
# Hackathon keys are restricted to this HTTPS host; other origins are rejected.
QLOO_API_ORIGIN=https://hackathon.api.qloo.com
# Explicit server-side launch switch. Keep 0 until live validation and abuse controls pass.
QLOO_LIVE_ENABLED=0
# Exact browser origin for production POST /api/plan (scheme, host, port).
# For the loopback P1 run use http://127.0.0.1:3100; public hosts must use HTTPS.
CROSSFADE_SITE_ORIGIN=
# Shared live-plan quota. Use a claimed free Upstash Redis database; keep the token server-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set only after the issued Qloo request allowance is known. Each plan reserves up to 24 attempts.
QLOO_LIVE_PLANS_PER_HOUR=
